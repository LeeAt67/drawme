# Copy to apps/api/.env and fill in your own values.
# AGENT_API_KEY is required by the API server. For Ollama or other
# unauthenticated local endpoints you can set any non-empty placeholder.
AGENT_API_BASE_URL=https://api.openai.com/v1
AGENT_API_KEY=sk-replace-me
AGENT_MODEL=gpt-4o-mini
AGENT_TIMEOUT_MS=60000
AGENT_RATE_LIMIT_PER_MINUTE=20
PORT=8787
HOST=0.0.0.0
# File-backed board storage. Keep this directory on a persistent volume.
DATA_DIR=data

# Local development is passwordless by default: every request runs as the
# fixed `user_local` identity and the browser hides the sign-in UI.
# WARNING: never leave this enabled on a public deployment. Set it to false
# and configure the account below before exposing the API.
AUTH_DISABLED=true

# Only used when AUTH_DISABLED=false. The API refuses to start in that mode
# without an account. Use AUTH_ADMIN_PASSWORD_HASH in production.
AUTH_ADMIN_EMAIL=admin@drawme.local
AUTH_ADMIN_PASSWORD=change-me
# AUTH_ADMIN_PASSWORD_HASH=scrypt$<salt>$<hash>
AUTH_RATE_LIMIT_PER_MINUTE=10

# Optional OAuth sign-in methods shown in the project-wide login dialog.
# JSON array; startUrl must be a site-relative path or an http(s) URL.
# The callback is not implemented yet - this only advertises providers.
# AUTH_OAUTH_PROVIDERS=[{"id":"github","name":"GitHub","startUrl":"/api/auth/oauth/github/start"}]

# Session cookies. Leave SESSION_COOKIE_NAME unset in production so the
# default __Host-drawme_session name is used when COOKIE_SECURE=true.
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
# SESSION_COOKIE_NAME=drawme_session

# Comma-separated extra browser origins allowed for unsafe /api requests.
# localhost:7200 is already trusted outside production.
# ALLOWED_ORIGINS=https://drawme.example.com

# Optional: let the API server host the built web app (dist/apps/web).
# WEB_DIST_DIR=dist/apps/web


